# Local template for the verified live project; inspect the installed unit before changing it.
[Unit]
Description=Expire due IRStore24 orders
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/irstore24-staging
ExecStart=/usr/bin/docker compose --project-name irstore24-staging --env-file /etc/irstore24/staging.env -f /opt/irstore24-staging/docker-compose.yml -f /opt/irstore24-staging/docker-compose.staging.yml -f /opt/irstore24-staging/docker-compose.production-live.yml exec -T api /opt/venv/bin/python -m app.jobs.expire_orders --batch-size 100
TimeoutStartSec=5min
