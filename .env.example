POSTGRES_DB=irstore24
POSTGRES_USER=irstore24
POSTGRES_PASSWORD=replace-with-a-strong-password


DB_HOST=127.0.0.1
DB_PORT=5432

# Production defaults to Secure cookies and https://irstore24.ir.
# For local HTTP development only, explicitly enable these overrides.
# Use the same hostname for the frontend and API so SameSite cookies work.
# Local host API media defaults to ignored backend/media; override with an absolute MEDIA_ROOT if needed.
# APP_ENV=development
# AUTH_COOKIE_SECURE=false
# AUTH_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
# Next.js development proxy only; defaults to http://127.0.0.1:8000.
# API_PROXY_TARGET=http://127.0.0.1:8000
